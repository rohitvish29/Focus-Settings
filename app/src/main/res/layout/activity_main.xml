<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Focus Settings"
    android:textSize="22sp"
    android:textStyle="bold"
    android:layout_marginBottom="32dp" />

<Button
    android:id="@+id/btnUsagePermission"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="1. Grant Usage Access Permission"
    android:layout_marginBottom="12dp" />

<Button
    android:id="@+id/btnWriteSettingsPermission"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="2. Grant Write Settings Permission"
    android:layout_marginBottom="24dp" />

<Button
    android:id="@+id/btnStartService"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="3. Start Automation Service" />
